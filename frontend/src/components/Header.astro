---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<header class="header glass">
    <div class="header-container">
        <h1>{title}</h1>
        <div class="user-info">
            <div class="avatar">👨‍⚕️</div>
            <span id="userName">Veterinario</span>
        </div>
    </div>
</header>

<style>
    .header {
        position: fixed;
        top: 1rem;
        right: 1.5rem;
        left: calc(260px + 1.5rem);
        padding: 1rem 2rem;
        z-index: 90;
        margin-bottom: 2rem;
    }

    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .avatar {
        width: 36px;
        height: 36px;
        background: #e2e8f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    span {
        font-weight: 500;
        font-size: 0.9rem;
    }
</style>
